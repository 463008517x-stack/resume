---
import { RESUME } from '@/data/resume';
import { type Locale } from '@/config';
import { pickLocale } from '@/i18n';
import Badge from '@/components/ui/Badge.astro';
import FadeIn from '@/components/interactive/FadeIn.tsx';

interface Props {
  locale: Locale;
  t: (key: string) => string;
}

const { locale, t } = Astro.props;
const { about } = RESUME;
---

<section id="about" class="py-24">
  <div class="container-prose">
    <FadeIn client:visible>
      <div class="section-heading">
        <span class="section-heading-num">01.</span>
        <h2 class="section-heading-text">{t('sections.about')}</h2>
        <span class="section-heading-line"></span>
      </div>
    </FadeIn>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-3">
      <FadeIn client:visible delay={0.1} className="md:col-span-2 space-y-4">
        {
          about.paragraphs.map((p) => (
            <p class="text-lg leading-relaxed text-zinc-600 dark:text-zinc-300">
              {pickLocale(p, locale)}
            </p>
          ))
        }
      </FadeIn>

      <FadeIn client:visible delay={0.2}>
        <div class="space-y-2">
          {about.tags.map((tag) => <Badge>{pickLocale(tag, locale)}</Badge>)}
        </div>
      </FadeIn>
    </div>
  </div>
</section>
