---
import { SITE } from '@/config';

interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: 'lazy' | 'eager';
  aspectRatio?: string;
}

const {
  src,
  alt,
  width,
  height,
  class: className = '',
  loading = 'lazy',
  aspectRatio,
} = Astro.props;

const finalSrc = src.startsWith('http') ? src : `${SITE.base}${src}`;
---

<div
  class:list={['relative overflow-hidden bg-zinc-100 dark:bg-zinc-900', className]}
  style={aspectRatio ? `aspect-ratio: ${aspectRatio}` : ''}
>
  <img
    src={finalSrc}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    decoding="async"
    class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
  />
  <div
    class="pointer-events-none absolute inset-0 bg-black/0 transition-colors dark:bg-black/10"
    aria-hidden="true"
  >
  </div>
</div>
