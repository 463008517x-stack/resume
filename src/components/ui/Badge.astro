---
interface Props {
  variant?: 'default' | 'accent' | 'mono';
  class?: string;
}
const { variant = 'default', class: className = '' } = Astro.props;

const variants = {
  default:
    'border-zinc-200 bg-zinc-50 text-zinc-700 dark:border-white/10 dark:bg-white/5 dark:text-zinc-300',
  accent: 'border-accent/30 bg-accent/10 text-accent',
  mono: 'border-zinc-200 bg-zinc-50 text-zinc-700 font-mono dark:border-white/10 dark:bg-white/5 dark:text-zinc-300',
};
---

<span
  class:list={[
    'inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-medium',
    variants[variant],
    className,
  ]}
>
  <slot />
</span>
