---
interface Props {
  class?: string;
  hoverable?: boolean;
}

const { class: className = '', hoverable = false } = Astro.props;
---

<div
  class:list={[
    'group relative overflow-hidden rounded-2xl border border-zinc-200/80 bg-white/60 backdrop-blur-sm transition-all duration-300',
    'dark:border-white/[0.08] dark:bg-white/[0.02]',
    hoverable && 'glow-border hover:-translate-y-0.5 hover:border-zinc-300 dark:hover:border-white/[0.15]',
    className,
  ]}
>
  <slot />
</div>
