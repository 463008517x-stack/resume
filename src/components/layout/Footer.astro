---
import { SITE, SOCIAL, type Locale } from '@/config';
import { Github } from 'lucide-react';

interface Props {
  locale: Locale;
  t: (key: string) => string;
}

const { t } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="relative mt-32 border-t border-zinc-200/60 dark:border-white/[0.06]">
  <div class="container-prose py-10">
    <div class="flex flex-col items-start justify-between gap-4 md:flex-row md:items-center">
      <div class="text-sm text-zinc-500 dark:text-zinc-400">
        © {year}
        {SITE.author} · {t('footer.copyright')}
      </div>

      <div class="flex items-center gap-4 text-sm text-zinc-500 dark:text-zinc-400">
        <span>{t('footer.built_with')}</span>
        <span class="text-zinc-300 dark:text-zinc-700">·</span>
        <a
          href={SOCIAL.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 transition-colors hover:text-accent"
        >
          <Github className="h-4 w-4" />
          {t('footer.source')}
        </a>
      </div>
    </div>
  </div>
</footer>
